# Required: token from @BotFather
BOT_TOKEN=

# Global admins: comma-separated Telegram user ids. They see and manage every chat in the Mini App.
# Find your id with /id-style bots, e.g. @userinfobot.
ADMIN_IDS=

# Optional: work only in these group chat ids (comma-separated); empty = any group
ALLOWED_CHATS=

# Time zone for "of the day" games (IANA name, e.g. Europe/Moscow, Asia/Tashkent)
TZ=UTC

# Public https URL of the Mini App (your reverse proxy / tunnel to HOST_PORT). Empty = Mini App off.
WEBAPP_URL=
# Short name from @BotFather /newapp; enables "open app" buttons in groups. Optional.
APP_SHORTNAME=

# Where docker publishes the Mini App port
HOST_BIND=127.0.0.1
HOST_PORT=8095

# Telegram Bot API upload limit is 50 MB
MAX_UPLOAD_MB=49
MAX_DURATION_SEC=900

# Optional Netscape cookies.txt inside data/ (YouTube "confirm you're not a bot", Instagram, ...)
COOKIES_FILE=

# INFO or DEBUG (DEBUG logs every incoming message: chat id and type only, never text)
LOG_LEVEL=INFO
